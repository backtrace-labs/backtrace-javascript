{
    "plugins": ["import"],
    "settings": {
        "import/ignore": ["node_modules"],
        "import/resolver": {
            "node": {
                "extensions": [".js", ".jsx", ".ts", ".tsx"]
            }
        }
    },
    "rules": {
        "import/no-cycle": ["error", { "ignoreExternal": true }]
    }
}
