{
    "extends": "./tsconfig.json",
    "exclude": ["node_modules", "tests", "lib"],
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "target": "ES5",
        "downlevelIteration": true,
        "lib": ["ESNext"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext"
    }
}
